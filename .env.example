# Discord webhook URL for sending job notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# (Optional) Daily scrape time in HH:MM format (default: 09:00)
# SCRAPE_SCHEDULE_TIME=09:00

# (Optional) OpenAI API key — enables "Ask AI fit" in the web dashboard
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# (Optional) CORS for dashboard API (comma-separated). Defaults to Vite dev server.
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
