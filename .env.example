# Discord webhook URL for sending job notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# (Optional) Daily scrape time in HH:MM format (default: 09:00)
# SCRAPE_SCHEDULE_TIME=09:00

# --- LLM agents (dashboard UI) — set ONE of these API keys ---
# OpenRouter (recommended): one key, many models via https://openrouter.ai/models
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: shown on OpenRouter rankings
# OPENROUTER_HTTP_REFERER=https://yoursite.example
# OPENROUTER_APP_TITLE=Job Scraper Dashboard

# Or OpenAI directly:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Per-agent models (optional). If unset, defaults depend on provider:
#   OpenRouter: fit=qwen/qwen3-next-80b-a3b-instruct:free, critique=meta-llama/llama-3.3-70b-instruct:free, checklist=google/gemma-4-26b-a4b-it:free
#   OpenAI.com: fit=gpt-4o-mini, critique=gpt-4o, checklist=gpt-4o-mini
# Pick any model from https://openrouter.ai/models (full slug, e.g. ...:free for free endpoints)
# AGENT_FIT_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
# AGENT_CRITIQUE_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AGENT_CHECKLIST_MODEL=google/gemma-4-26b-a4b-it:free

# (Optional) CORS — comma-separated. Include your public URL when using Cloudflare Tunnel, e.g.
# CORS_ORIGINS=https://jobs.yourdomain.com,http://127.0.0.1:5173,http://localhost:8765

# --- Docker / homelab ---
# Single port serves UI + API (FastAPI). Cloudflare Tunnel → http://127.0.0.1:8765
# JOB_SCRAPER_STATE_DIR=/var/lib/job-scraper

# Dashboard “Scrape now” button — set a long random secret; leave unset to hide the button
# SCRAPE_NOW_CODE=your-long-random-secret
